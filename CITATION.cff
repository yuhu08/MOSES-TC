cff-version: 1.2.0
message: "If you use MOSES-TC, please cite this release and the accompanying paper."
title: "MOSES-TC: Marginal-Optimized Spatial Events Sampling"
type: software
version: "1.0.0"
authors:
  - given-names: Yu
    family-names: Hu
  - given-names: Dazhi
    family-names: Xi
  - given-names: Yurong
    family-names: Gao
